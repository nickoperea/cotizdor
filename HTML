              access: { allowed: false, msg: 'Sin precio DNP aplicable' },
              partnerName, partnerLevel, country, region: effectiveRegion
            };
          }
        } else if (priceItem) {
          const listCandidates = [];
          const listLevelColumns = {
            'PREMIER BUSINESS PARTNER': 'G',
            'BUSINESS PARTNER': 'H',
            'PREMIER SOLUTION PARTNER': 'I',
            'SOLUTION PARTNER': 'J',
            'PREMIER BROADLINE TECHNOLOGY RESELLER': 'K',
            'BROADLINE TECHNOLOGY RESELLER': 'L',
            'REGISTERED RESELLER': 'M',
            'GLOBAL SYSTEM INTEGRATOR': 'N',
            'SUB DISTRIBUTOR': 'AO',
            'AUTHORIZED SUB DISTRIBUTOR': 'AO'
          };
          let listLevelColumn = listLevelColumns[normalizedLevel];
          if (!listLevelColumn && normalizedLevel.includes('SUB DISTRIBUTOR')) listLevelColumn = 'AO';
          if (!listLevelColumn && normalizedLevel.includes('PREMIER BUSINESS PARTNER')) listLevelColumn = 'G';
          if (!listLevelColumn && normalizedLevel.includes('BUSINESS PARTNER')) listLevelColumn = 'H';
          if (!listLevelColumn && normalizedLevel.includes('PREMIER SOLUTION PARTNER')) listLevelColumn = 'I';
          if (!listLevelColumn && normalizedLevel.includes('SOLUTION PARTNER')) listLevelColumn = 'J';
          if (!listLevelColumn && normalizedLevel.includes('PREMIER BROADLINE TECHNOLOGY RESELLER')) listLevelColumn = 'K';
          if (!listLevelColumn && normalizedLevel.includes('BROADLINE TECHNOLOGY RESELLER')) listLevelColumn = 'L';
          if (!listLevelColumn && normalizedLevel.includes('GLOBAL SYSTEM INTEGRATOR')) listLevelColumn = 'N';
          if (!listLevelColumn) listLevelColumn = 'M';

          const levelListPrice = parsePrice(priceItem[listLevelColumn]);
          if (levelListPrice !== null) listCandidates.push({ price: levelListPrice, source: `Lista (Nivel ${partnerLevel} - Col. ${listLevelColumn})` });

          listSpecializations.forEach(({ label, column }) => {
            if (!hasSpecialization(label)) return;
            const price = parsePrice(priceItem[column]);
            if (price !== null) listCandidates.push({ price, source: `Lista (${label} - Col. ${column})` });
          });

          if (listCandidates.length > 0) {
            listCandidates.sort((a, b) => a.price - b.price);
            bestPrice = listCandidates[0].price;
            bestSource = listCandidates[0].source;

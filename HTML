        if (!cleanVal) { setPartnerNameInput(''); return; }
        const match = partnerList.find(p => clean(p.id) === cleanVal || Object.values(p.raw).some(v => clean(v) === cleanVal));
        if (match) setPartnerNameInput(match.name);

      const [promoCrudError, setPromoCrudError] = useState(false);
      const [promoEditingId, setPromoEditingId] = useState('');
      const [promoForm, setPromoForm] = useState({
        codigo:'', region:'COLOMBIA', tipoCoincidencia:'EXACTO', patronSKU:'',
        tipoDescuento:'FIJO', valorDescuento:'', fechaInicio:'', fechaFin:'',
        activa:true, excluirDNP:false, observaciones:''
      });
      
      const isAdminUser = usersAccessVerified && clean(currentUser?.role) === 'ADMINISTRADOR';

      const refreshAnalytics = async () => {
        setAnalyticsLoading(true);
        try {
          if (ANALYTICS_API_URL) {
            const events = await fetchCentralAnalytics(currentUser?.username || '');
            setAnalyticsEvents(events);
            setAnalyticsMessage(`Datos centralizados · ${events.length.toLocaleString('es-CO')} eventos registrados.`);
          } else {
            const events = readLocalAnalytics();
            setAnalyticsEvents(events);
            setAnalyticsMessage('Analítica local de este navegador. Configura Apps Script para consolidar la actividad de todos los usuarios.');
          }
        } catch (err) {
          setAnalyticsEvents(readLocalAnalytics());
          setAnalyticsMessage(`No se pudo consultar el registro central. Se muestran datos locales de este navegador. ${err.message || ''}`);
        } finally { setAnalyticsLoading(false); }
      };

      useEffect(() => {
        if (isAdminUser && activeModule === 'admin') refreshAnalytics();
      }, [isAdminUser, activeModule]);

      const filteredAnalytics = useMemo(() => {
        const now = new Date();
        const days = analyticsPeriod === 'all' ? null : Number(analyticsPeriod);
        return analyticsEvents.filter(event => {
          if (!days) return true;
          const date = getAnalyticsDate(event);
          return date && date >= new Date(now.getTime() - days * 86400000);
        });
      }, [analyticsEvents, analyticsPeriod]);

      const promotionApiRequest = async (payload) => {
        if (!ANALYTICS_API_URL) throw new Error('Endpoint de Apps Script no configurado.');
        const requestId = (window.crypto && typeof window.crypto.randomUUID === 'function')
          ? window.crypto.randomUUID()
          : Array.from(window.crypto.getRandomValues(new Uint8Array(24))).map(b => b.toString(16).padStart(2,'0')).join('');
        const iframeName = 'zpdPromoFrame_' + requestId.replace(/-/g,'');
        const iframe = document.createElement('iframe');
        iframe.name = iframeName;
        iframe.style.display = 'none';
        document.body.appendChild(iframe);
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = ANALYTICS_API_URL;
        form.target = iframeName;
        form.style.display = 'none';
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'payload';
        input.value = JSON.stringify({...payload, requestId});
        form.appendChild(input);
        document.body.appendChild(form);
        const postPromise = new Promise((resolve, reject) => {
          const timer = setTimeout(() => reject(new Error('No se pudo completar el envío al servidor.')), 12000);
          iframe.addEventListener('load', () => { clearTimeout(timer); resolve(); }, {once:true});
          form.submit();
        });
        try {
          await postPromise;
        } finally {
          form.remove();
          iframe.remove();
        }
        const started = Date.now();
        let lastError = 'El servidor todavía no devuelve respuesta.';
        while (Date.now() - started < 20000) {
          try {
            const result = await new Promise((resolve, reject) => {
              const callbackName = '__zpdPromo_' + requestId.replace(/-/g,'') + '_' + Date.now();
              const script = document.createElement('script');
              let settled = false;
              const cleanup = () => {
                script.remove();
                try { delete window[callbackName]; } catch(e) { window[callbackName] = undefined; }
              };
              const timer = setTimeout(() => {
                if (settled) return;
                settled = true; cleanup(); reject(new Error('Tiempo de espera consultando la respuesta.'));
              }, 4500);
              window[callbackName] = data => {
                if (settled) return;
                settled = true; clearTimeout(timer); cleanup(); resolve(data);
              };
              script.onerror = () => {
                if (settled) return;
                settled = true; clearTimeout(timer); cleanup(); reject(new Error('No fue posible consultar la respuesta de Apps Script.'));
              };
              script.src = ANALYTICS_API_URL + '?action=promotion_result&requestId=' +
                encodeURIComponent(requestId) + '&callback=' + encodeURIComponent(callbackName) +
                '&_=' + Date.now();
              document.head.appendChild(script);
            });
            if (result && result.ok) return result;
            const message = String(result?.error || '');
            if (message.includes('Resultado no disponible') || result?.pending === true) {
              lastError = message || lastError;
              await new Promise(resolve => setTimeout(resolve, 450));
              continue;
            }
            throw new Error(message || 'El servidor rechazó la operación.');
          } catch (err) {
            if (String(err.message || '').includes('Tiempo de espera') ||
                String(err.message || '').includes('No fue posible consultar')) {
              lastError = err.message;
              await new Promise(resolve => setTimeout(resolve, 450));
              continue;
            }
            throw err;
          }
        }
        throw new Error(lastError + ' Se agotó el tiempo de espera.');
      };

      const promotionApiToRows = (promotions) => (promotions || []).map(p => ({
        A:p.id, B:p.codigo, C:p.region, D:p.tipoCoincidencia, E:p.patronSKU,
        F:p.tipoDescuento, G:p.valorDescuento, H:p.fechaInicio, I:p.fechaFin,
        J:p.activa, K:p.excluirDNP, L:p.observaciones
      }));

      const loadPromotionsFromApi = async (key = promoAdminKey) => {
        const result = await promotionApiRequest({action:'promotion_list', adminKey:key});
        setPromotionsData(promotionApiToRows(result.promotions));
        return result.promotions || [];
      };

      const unlockPromotionAdmin = async () => {
        if (!promoAdminKey.trim()) {
          setPromoCrudError(true); setPromoCrudMessage('Ingresa la clave administrativa.'); return;
        }
        setPromoCrudLoading(true); setPromoCrudMessage('Verificando acceso...'); setPromoCrudError(false);
        try {
          await loadPromotionsFromApi(promoAdminKey);
          setPromoAdminUnlocked(true);
          setPromoCrudMessage('Acceso administrativo habilitado.');
        } catch (err) {
          setPromoAdminUnlocked(false); setPromoCrudError(true);
          setPromoCrudMessage(err.message || 'No fue posible validar la clave.');
        } finally { setPromoCrudLoading(false); }
      };

      const resetPromotionForm = () => {
        setPromoEditingId('');
        setPromoForm({codigo:'',region:'COLOMBIA',tipoCoincidencia:'EXACTO',patronSKU:'',tipoDescuento:'FIJO',valorDescuento:'',fechaInicio:'',fechaFin:'',activa:true,excluirDNP:false,observaciones:''});
      };

      const editPromotion = row => {
        setPromoEditingId(row.id);
        setPromoForm({
          codigo:row.code, region:row.region, tipoCoincidencia:row.matchType,
          patronSKU:row.pattern, tipoDescuento:row.discountType,
          valorDescuento:String(row.discountValue ?? ''),
          fechaInicio:row.startDate ? row.startDate.toISOString().slice(0,10) : '',
          fechaFin:row.endDate ? row.endDate.toISOString().slice(0,10) : '',
          activa:row.enabled, excluirDNP:row.excludeDnp, observaciones:row.notes
        });
        setPromoCrudMessage('Editando ' + row.code);
        window.scrollTo({top:0,behavior:'smooth'});
      };

      const savePromotion = async event => {
        event.preventDefault();
        const value = Number(promoForm.valorDescuento);
        const skuPatterns = [...new Set(promoForm.patronSKU.split(',').map(value => value.trim()).filter(Boolean))];
        if (!promoForm.codigo.trim() || !skuPatterns.length || !Number.isFinite(value) || value <= 0) {
          setPromoCrudError(true); setPromoCrudMessage('Completa código, al menos un SKU/prefijo y un descuento positivo.'); return;
        }
        if (promoForm.tipoDescuento === 'PORCENTAJE' && value > 100) {
          setPromoCrudError(true); setPromoCrudMessage('El porcentaje no puede superar el 100%.'); return;
        }
        setPromoCrudLoading(true); setPromoCrudError(false); setPromoCrudMessage('Guardando promoción...');
        const promotion = {...promoForm, patronSKU:skuPatterns.join(', '), valorDescuento:value};
        try {
          const result = await promotionApiRequest({
            action:promoEditingId ? 'promotion_update' : 'promotion_create',
            adminKey:promoAdminKey, ...(promoEditingId ? {id:promoEditingId} : {}), promotion
          });
          await loadPromotionsFromApi();
          resetPromotionForm();
          setPromoCrudMessage(result.message || 'Promoción guardada correctamente.');
        } catch (err) {
          setPromoCrudError(true); setPromoCrudMessage(err.message || 'No fue posible guardar la promoción.');
        } finally { setPromoCrudLoading(false); }
      };

      const togglePromotion = async row => {
        setPromoCrudLoading(true); setPromoCrudError(false); setPromoCrudMessage('Actualizando estado...');
        try {
          const result = await promotionApiRequest({action:'promotion_toggle',adminKey:promoAdminKey,id:row.id,active:!row.enabled});
          await loadPromotionsFromApi();
          setPromoCrudMessage(result.message || 'Estado actualizado.');
        } catch (err) { setPromoCrudError(true); setPromoCrudMessage(err.message || 'No fue posible cambiar el estado.'); }
        finally { setPromoCrudLoading(false); }
      };

      const deletePromotion = async row => {
        if (!window.confirm('¿Eliminar definitivamente la promoción ' + row.code + '? Esta acción no se puede deshacer.')) return;
        setPromoCrudLoading(true); setPromoCrudError(false); setPromoCrudMessage('Eliminando promoción...');
        try {
          const result = await promotionApiRequest({action:'promotion_delete',adminKey:promoAdminKey,id:row.id});
          await loadPromotionsFromApi();
          if (promoEditingId === row.id) resetPromotionForm();
          setPromoCrudMessage(result.message || 'Promoción eliminada.');
        } catch (err) { setPromoCrudError(true); setPromoCrudMessage(err.message || 'No fue posible eliminar la promoción.'); }
        finally { setPromoCrudLoading(false); }
      };

      const promotionRows = useMemo(() => {
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        return (promotionsData || []).map((row, index) => {
          const code = String(row['B'] || row['col_1'] || '').trim();
          const region = String(row['C'] || row['col_2'] || '').trim();
          const matchType = String(row['D'] || row['col_3'] || '').trim();
          const pattern = String(row['E'] || row['col_4'] || '').trim();
          const discountType = clean(row['F'] || row['col_5'] || '');
          const discountValue = parsePrice(row['G'] ?? row['col_6']);
          const startDate = parsePromotionDate(row['H'] ?? row['col_7']);
          const endDate = parsePromotionDate(row['I'] ?? row['col_8']);
          const enabled = isSheetTrue(row['J'] ?? row['col_9']);
          let status = 'Activa';
          if (!enabled) status = 'Inactiva';
          else if (startDate && today < startDate) status = 'Programada';
          else if (endDate && today > endDate) status = 'Vencida';
          return { id:String(row['A'] || row['col_0'] || index), code, region, matchType, pattern, discountType, discountValue, startDate, endDate, enabled, status, excludeDnp:isSheetTrue(row['K'] ?? row['col_10']), notes:String(row['L'] || row['col_11'] || '').trim() };
        }).filter(row => row.code);
      }, [promotionsData]);

      const filteredPromotionRows = useMemo(() => {
        const query = clean(promotionSearch);
        return promotionRows.filter(row => {
          const matchesSearch = !query || clean([row.code,row.pattern,row.region,row.notes].join(' ')).includes(query);
          const matchesRegion = promotionRegionFilter === 'TODAS' || row.region.split(',').map(clean).includes(promotionRegionFilter);
          const matchesStatus = promotionStatusFilter === 'TODAS' || clean(row.status) === promotionStatusFilter;
          return matchesSearch && matchesRegion && matchesStatus;
        });
      }, [promotionRows,promotionSearch,promotionRegionFilter,promotionStatusFilter]);

      const promotionCounts = useMemo(() => ({
        total:promotionRows.length,
        active:promotionRows.filter(row => row.status === 'Activa').length,
        inactive:promotionRows.filter(row => row.status !== 'Activa').length
      }), [promotionRows]);

      const analyticsSummary = useMemo(() => {
        const field = (event, ...candidates) => {
          if (!event) return '';
          const keys = Object.keys(event);
          for (const candidate of candidates) {
            const match = keys.find(key => clean(key) === clean(candidate));
            if (match && event[match] !== null && event[match] !== undefined) return event[match];
          }
          return '';
        };

        const normalized = filteredAnalytics.map(event => ({
          ...event,
          eventType: String(field(event, 'eventType', 'Tipo', 'tipo')).trim().toLowerCase(),
          sku: String(field(event, 'sku', 'SKU', 'Referencia')).trim(),
          partnerName: String(field(event, 'partnerName', 'Partner', 'Nombre partner')).trim(),
          promoCode: String(field(event, 'promoCode', 'Promoción', 'Promo')).trim(),
          username: String(field(event, 'username', 'Usuario', 'Username')).trim(),
          userName: String(field(event, 'userName', 'Nombre', 'Nombre usuario')).trim(),
          status: String(field(event, 'status', 'Estado')).trim().toUpperCase(),
          accessMessage: String(field(event, 'accessMessage', 'Detalle', 'Motivo')).trim(),
          discountApplied: field(event, 'discountApplied', 'Descuento USD', 'Descuento')
        }));

        const sessions = normalized.filter(e => e.eventType === 'quote_session');
        const items = normalized.filter(e => e.eventType === 'quote_item');
        
        const byKey = (rows, keyFn) => {
          const map = new Map();
          rows.forEach(row => {
            const key = String(keyFn(row) || '').trim();
            if (!key) return;
            map.set(key, (map.get(key) || 0) + 1);
          });
          return [...map.entries()]
            .map(([name, count]) => ({ name, count }))
            .sort((a,b) => b.count - a.count || a.name.localeCompare(b.name));
        };

        const eligibleItems = items.filter(e => e.status === 'OK');
        const promos = eligibleItems.filter(e => Number(e.discountApplied) > 0 && e.promoCode && clean(e.promoCode) !== 'SIN PROMO');
        const blocked = items.filter(e => e.status === 'BLOQUEADA');
        const noPrice = items.filter(e => e.status === 'SIN_PRECIO');
        const noPriceUnique = new Set(noPrice.map(e => clean(e.sku)).filter(Boolean)).size;

        return {
          quotes: sessions.length,
          skuQueries: items.length,
          partners: new Set(sessions.map(e => clean(e.partnerName)).filter(Boolean)).size,
          promoUses: promos.length,
          discounts: eligibleItems.reduce((sum, e) => sum + (Number(e.discountApplied) || 0), 0),
          blocked: blocked.length,
          noPrice: noPriceUnique,

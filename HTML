        try {
          const { jsPDF } = window.jspdf;
          const doc = new jsPDF();
          const validResults = getExportResults();
          if (validResults.length === 0) return;
          doc.setFillColor(0,0,0);
          doc.rect(0,0,210,38,'F');
          doc.setFillColor(0,115,230);
          doc.rect(0,38,210,3,'F');
          doc.setTextColor(255,255,255);
          doc.setFontSize(18);
          doc.text('COTIZACIÓN OFICIAL ZEBRA - INTCOMEX',15,24);
          doc.setTextColor(0,0,0);
          doc.setFontSize(10);
          doc.text(`Fecha: ${new Date().toLocaleDateString()}`,15,48);
          doc.text(`Generado por: ${currentUser.name}`,15,54);
          doc.text(`Partner: ${validResults[0]?.partnerName || 'N/A'}`,15,60);
          
          const tableData = validResults.map(r => [
            r.sku || 'N/A',
            (r.description || r.error || '').substring(0,35),
            r.boxQty > 1 ? `Caja x ${r.boxQty}` : 'Und',
            `$${(Number(r.basePrice) || 0).toFixed(2)}`,
            r.promoCode || 'Sin Promo',
            `$${(Number(r.boxTotal) || 0).toFixed(2)}`,
            r.access?.allowed ? 'PERMITIDO' : (r.access?.msg || 'BLOQUEADO')
          ]);
          
          doc.autoTable({
            startY:68,
            head:[['SKU','Descripción','Empaque','Precio ant. (Und)','Promo','TOTAL CAJA','Estado']],
            body:tableData,
            headStyles:{ fillColor:[0,0,0] },
            styles:{ fontSize:8 }
          });
          doc.save(`Cotizacion_Zebra_${new Date().getTime()}.pdf`);
        } catch (e) { console.error('Error al exportar PDF:',e); alert('Ocurrió un error al generar el PDF.'); }
      };

      const resultsExist = Boolean(searchResult) || bulkResults.length > 0;
      const syncState = loadingDrive ? 'pending' : (syncStatus.startsWith('Cargado') ? 'ok' : (syncStatus.startsWith('Error') ? 'error' : 'pending'));


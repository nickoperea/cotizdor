        }

        if (bestPrice !== null) {
          const promoEval = evaluatePromotions(targetSku, effectiveRegion, country, bestPrice, Boolean(dnpItem), promotionsData);
          const originalItem = priceItem || dnpItem;
          
          // --- NUEVA LÓGICA DE EMPAQUE (CAJAS) ---
          // Validamos primero que la columna AT indique "Barcode Supplies"
          const categoryAT = clean(originalItem['AT'] || originalItem['col_45'] || getFlexibleValue(originalItem, 'FAMILY') || getFlexibleValue(originalItem, 'LOB') || '');
          const isBarcodeSupply = categoryAT.includes('BARCODE SUPPLIES');
          
          let boxQty = 1;
          
          if (isBarcodeSupply) {
            // Buscamos específicamente en la columna BQ (o alternativos si la matriz cambia)
            const rawBoxQty = originalItem['BQ'] || originalItem['col_68'] || getFlexibleValue(originalItem, 'BOX') || getFlexibleValue(originalItem, 'MOQ') || getFlexibleValue(originalItem, 'UNID') || 1;
            const parsedBoxQty = parseInt(rawBoxQty, 10);
            if (!isNaN(parsedBoxQty) && parsedBoxQty > 0) {
              boxQty = parsedBoxQty;
            }
          }
          
          const boxTotal = promoEval.finalPrice * boxQty;

          return {
            sku: targetSku,
            description: String(originalItem?.['Material Description'] || originalItem?.['Description'] || 'Producto Zebra'),
            basePrice: bestPrice,
            finalPrice: promoEval.finalPrice,
            boxQty: boxQty,
            boxTotal: boxTotal,
            promoCode: promoEval.promoCode,
            discountApplied: promoEval.discountApplied,
            listPrice: msrp,
            source: bestSource,
            access,
            rawAccessCode: String(accessCode || '1-Open'),
            partnerName, partnerLevel, country, region: effectiveRegion
          };
        }
        return { sku: targetSku, error: 'Sin precio asignable en bases de datos', source: 'N/A', access: { allowed: false, msg: 'Sin Precio' } };
      };

      const handleCalculate = () => {
        setRegionError(false);
        if (partnerType === 'registered' && !partnerId.trim() && !partnerNameInput.trim()) { setPartnerError(true); return; }
        if (partnerType === 'new' && (!manualRegion || manualRegion === '')) { setRegionError(true); return; }
        let partnerObj = null;
        if (partnerType === 'registered') {
          partnerObj = partnerLevelData.find(p => clean(p['A']) === clean(partnerId) || clean(p['B']) === clean(partnerNameInput));
          if (!partnerObj && partnerId) partnerObj = partnerLevelData.find(p => Object.values(p).some(v => clean(v) === clean(partnerId)));
          if (!partnerObj && partnerNameInput) partnerObj = partnerLevelData.find(p => clean(p['B']).includes(clean(partnerNameInput)));
          if (partnerObj) setCurrentPartner(partnerObj);
        }
        let results = [];
        if (inputMode === 'single') {
          if (!skuSearch.trim()) { setSkuError(true); return; }
          setSkuError(false);
          results = [getSingleQuote(skuSearch, partnerObj, manualRegion)].filter(Boolean);
          setSearchResult(results[0] || null);
        } else {
          const skus = bulkSkus.split(/[\n,]+/).map(s => s.trim()).filter(s => s !== '');
          if (skus.length === 0) { setSkuError(true); return; }
          setSkuError(false);
          results = skus.map(s => getSingleQuote(s, partnerObj, manualRegion)).filter(Boolean);
          setBulkResults(results);
        }
        const quoteId = `Q-${Date.now()}-${Math.floor(Math.random()*100000)}`;
        const first = results[0] || {};
        const timestamp = new Date().toISOString();
        const common = {
          timestamp, quoteId, username: currentUser?.username || '', userName: currentUser?.name || '',
          partnerName: first.partnerName || (partnerType === 'new' ? newPartnerName : (partnerObj?.['B'] || partnerNameInput)) || 'Partner no identificado',
          partnerId: partnerObj?.['A'] || partnerId || '', partnerLevel: first.partnerLevel || '', country: first.country || '', region: first.region || ''
        };
        const events = [{ ...common, eventType: 'quote_session', skuCount: results.length, status: inputMode === 'bulk' ? 'MASIVA' : 'INDIVIDUAL' }];
        results.forEach(r => {
          let status = 'OK';
          if (r?.error && String(r.error).toLowerCase().includes('sin precio')) status = 'SIN_PRECIO';
          else if (r?.error) status = 'NO_ENCONTRADO';
          else if (r?.access && !r.access.allowed) status = 'BLOQUEADA';
          events.push({
            ...common, eventType: 'quote_item', sku: r?.sku || '', partnerName: r?.partnerName || common.partnerName,
            partnerLevel: r?.partnerLevel || common.partnerLevel, country: r?.country || common.country, region: r?.region || common.region,
            basePrice: r?.basePrice ?? '', finalPrice: r?.finalPrice ?? '', discountApplied: r?.discountApplied ?? 0,
            promoCode: r?.promoCode || 'Sin Promo', accessAllowed: r?.access?.allowed ?? false,
            accessMessage: r?.access?.msg || r?.error || '', status
          });
        });
        sendAnalyticsEvents(events, currentUser?.username || '');
      };

      const getExportResults = () => (inputMode === 'single' ? [searchResult] : bulkResults).filter(Boolean);
      
      const exportToExcel = () => {
        if (!window.XLSX) { alert('No fue posible cargar el módulo de Excel. Recarga la página e intenta de nuevo.'); return; }
        const results = inputMode === 'single' ? [searchResult] : bulkResults;
        const worksheetData = results.filter(Boolean).map(r => ({
          SKU: r.sku,
          Descripción: r.description || r.error,
          'Empaque': r.boxQty > 1 ? `Caja x ${r.boxQty} unds` : 'Unidad',
          'MSRP (List Price Unitario)': r.listPrice,
          'Precio Base Unitario (USD)': r.basePrice,
          'Descuento Unitario (USD)': r.discountApplied ?? 0,
          'Código Promo': r.promoCode,
          'Precio Final Unitario (USD)': r.finalPrice,
          'TOTAL CAJA FOB Miami (USD)': r.boxTotal,
          'Access Code': r.rawAccessCode,
          'Estado / Alerta': r.access?.allowed ? 'VENTA PERMITIDA' : r.access?.msg,
          Fuente: r.source
        }));
        const worksheet = window.XLSX.utils.json_to_sheet(worksheetData);
        const workbook = window.XLSX.utils.book_new();
        window.XLSX.utils.book_append_sheet(workbook, worksheet, 'Cotización Zebra');
        window.XLSX.writeFile(workbook, `Cotizacion_Zebra_${new Date().getTime()}.xlsx`);
      };

      const exportToPDF = () => {

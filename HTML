      const validateAccess = (code, level) => {
        const c = clean(code);
        const lvl = clean(level);
        if (lvl === 'INACTIVE') {
          if (c.includes('1-OPEN')) return { allowed: true };
          return { allowed: false, msg: 'Requiere inscribirse al Programa de Canales' };
        }
        if (c.includes('1-OPEN')) return { allowed: true };
        if (c.includes('2-PROGRAM')) {
          const isPartner = lvl && lvl !== '' && lvl !== 'N/A';
          return isPartner ? { allowed: true } : { allowed: false, msg: 'Requiere Nivel de Partner' };
        }
        if (c.includes('3-SPECIALIST')) return { allowed: true };
        if (c.includes('4-QUALIFICATION') || c.includes('5-APPROVAL')) return { allowed: false, msg: 'Aprobación de Marca Pendiente' };
        return { allowed: true };
      };

      const getSingleQuote = (sku, partnerObj, regionParam) => {
        const targetSku = clean(sku);
        if (!targetSku) return null;
        const priceItem = priceListData.find(item => clean(item['A']) === targetSku || clean(item['Material']) === targetSku || clean(item['Part Number']) === targetSku);
        const dnpItem = dnpData.find(item => clean(item['A']) === targetSku || clean(item['Part Number (SKU)']) === targetSku || clean(item['Material']) === targetSku);
        const NOT_FOUND_MSG = 'No encontrado en bases de datos, verifique que esté correcto o comuníquese con el equipo de Zebra';
        if (!priceItem && !dnpItem) return { sku: targetSku, error: NOT_FOUND_MSG, source: 'N/A', access: { allowed: false, msg: 'No encontrado' } };

        let partnerLevel = 'Registered Reseller';
        let country = 'Colombia';
        let partnerName = 'Partner Nuevo';
        let isSubDistri = false;

        if (partnerType === 'registered' && partnerObj) {
          partnerName = partnerObj['B'] || partnerObj['Partner'] || partnerNameInput;
          country = partnerObj['E'] || partnerObj['col_4'] || 'Colombia';
          if (clean(partnerObj['AC']) === 'SUB - DISTRIBUTOR' || clean(partnerObj['AC']) === 'SUB-DISTRIBUTOR') {
            isSubDistri = true;
            partnerLevel = 'Sub - Distributor';
          } else {
            partnerLevel = partnerObj['Reseller Track'] || partnerObj['Partner Track'] || partnerObj['D'] || 'Registered Reseller';
          }
        } else if (partnerType === 'new') {
          partnerName = newPartnerName || 'Partner Nuevo';
          partnerLevel = 'Registered Reseller';
          country = manualRegion || 'Colombia';
        }

        const effectiveRegion = manualRegion || getRegionForCountry(country);
        const accessCode = priceItem ? (priceItem['Access Code'] || priceItem['B'] || '1-Open') : '1-Open';
        const access = validateAccess(accessCode, partnerLevel);
        let msrp = 'N/A';
        const rawMsrp = (dnpItem && dnpItem['D']) ? dnpItem['D'] : (priceItem && priceItem['D']) ? priceItem['D'] : null;
        const parsedMsrp = parsePrice(rawMsrp);
        if (parsedMsrp !== null) msrp = parsedMsrp.toFixed(2);
        else if (rawMsrp) msrp = rawMsrp.toString().replace(/^\$/, '').trim();

        const normalizedLevel = clean(partnerLevel).replace(/[^A-Z0-9]+/g, ' ').trim();
        let dnpLevelColumn = 'U';
        if (normalizedLevel.includes('GLOBAL SYSTEM INTEGRATOR') ||
            normalizedLevel.includes('PREMIER BUSINESS PARTNER') ||
            normalizedLevel.includes('PREMIERE BUSINESS PARTNER') ||
            normalizedLevel.includes('PREMIER SOLUTION PARTNER') ||
            normalizedLevel.includes('PREMIERE SOLUTION PARTNER')) {
          dnpLevelColumn = 'M';
        } else if (normalizedLevel.includes('BUSINESS PARTNER') || normalizedLevel.includes('SOLUTION PARTNER')) {
          dnpLevelColumn = 'Q';
        } else if (normalizedLevel.includes('SUB DISTRIBUTOR') || normalizedLevel.includes('AUTHORIZED SUB DISTRIBUTOR')) {
          dnpLevelColumn = 'Y';
        } else if (normalizedLevel.includes('BROADLINE TECHNOLOGY RESELLER') || normalizedLevel.includes('REGISTERED RESELLER')) {
          dnpLevelColumn = 'U';
        }

        const listSpecializations = [
          { label: 'Card Printer Specialist', column: 'O' },
          { label: 'Advanced Card Printer Specialist', column: 'P' },
          { label: 'Advanced Print Engine Specialist', column: 'Q' },
          { label: 'Labeling Solutions Specialist', column: 'R' },
          { label: 'Advanced Labeling Solutions Specialist', column: 'S' },
          { label: 'RFID Specialist', column: 'T' },
          { label: 'Advanced RFID Specialist', column: 'U' },
          { label: 'Advanced Printer Repair Specialist - Card Printer', column: 'V' },
          { label: 'Printer Repair Specialist - Card Printer', column: 'W' },
          { label: 'Advanced Printer Repair Specialist - Label Printer', column: 'X' },
          { label: 'Printer Repair Specialist - Label Printer', column: 'Y' },
          { label: 'Advanced Printer Repair Specialist - Mobile Printer', column: 'Z' },
          { label: 'Printer Repair Specialist - Mobile Printer', column: 'AA' },
          { label: 'Advanced Printer Repair Specialist - Print Engine', column: 'AB' },
          { label: 'Printer Repair Specialist - Print Engine', column: 'AC' },
          { label: 'Service Approval Specialist - Card Printer', column: 'AD' },
          { label: 'Service Approval Specialist - Label Printer', column: 'AE' },
          { label: 'Service Approval Specialist - Mobile Printer', column: 'AF' },
          { label: 'Service Approval Specialist - Print Engine', column: 'AG' },
          { label: 'Purchase Approval Specialist - Card Printer', column: 'AH' },
          { label: 'Purchase Approval Specialist - Label Printer', column: 'AI' },
          { label: 'Purchase Approval Specialist - Mobile Printer', column: 'AJ' },
          { label: 'Purchase Approval Specialist - Print Engine', column: 'AK' },
          { label: 'TC20/TC25 Battery Replacement Program', column: 'AL' },
          { label: 'Healthcare Specialist', column: 'AM' },
          { label: 'Advanced Healthcare Specialist', column: 'AN' }
        ];

        const partnerEntries = partnerObj ? Object.entries(partnerObj) : [];
        const isActiveFlag = value => {
          const v = clean(value);
          return !!v && !['0', 'FALSE', 'NO', 'N', 'INACTIVE', 'INACTIVO', 'NOT ACTIVE'].includes(v);
        };
        const hasSpecialization = label => {
          const target = clean(label).replace(/[^A-Z0-9]+/g, ' ').trim();
          const targetVariants = [target, target.replace('PRINTER ', 'PRINTERS ')];
          const matchesExactSpecialization = source => targetVariants.some(variant => {
            let index = source.indexOf(variant);
            while (index !== -1) {
              const prefix = source.slice(0, index).trim();
              if (variant.startsWith('ADVANCED ') || !prefix.endsWith('ADVANCED')) return true;
              index = source.indexOf(variant, index + variant.length);
            }
            return false;
          });
          return partnerEntries.some(([key, value]) => {
            const normalizedValue = clean(value).replace(/[^A-Z0-9]+/g, ' ').trim();
            const normalizedKey = clean(key).replace(/[^A-Z0-9]+/g, ' ').trim();
            if (matchesExactSpecialization(normalizedValue)) return true;
            return matchesExactSpecialization(normalizedKey) && isActiveFlag(value);
          });
        };

        let bestPrice = null;
        let bestSource = '';

        if (dnpItem) {
          const dnpCandidates = [];
          const levelPrice = parsePrice(dnpItem[dnpLevelColumn]);
          if (levelPrice !== null) dnpCandidates.push({ price: levelPrice, source: `DNP (Nivel ${partnerLevel} - Col. ${dnpLevelColumn})` });

          if (hasSpecialization('Advanced Card Printer Specialist') || hasSpecialization('Advanced Card Printers Specialist')) {
            const price = parsePrice(dnpItem['AA']);
            if (price !== null) dnpCandidates.push({ price, source: 'DNP (Advanced Card Printers Specialist - Col. AA)' });
          }
          if (hasSpecialization('Card Printer Specialist') || hasSpecialization('Card Printers Specialist')) {
            const price = parsePrice(dnpItem['AC']);
            if (price !== null) dnpCandidates.push({ price, source: 'DNP (Card Printers Specialist - Col. AC)' });
          }

          const dnpPriceColumns = ['M', 'Q', 'U', 'Y', 'AA', 'AC'];
          const hasAnyDnpPrice = dnpPriceColumns.some(column => parsePrice(dnpItem[column]) !== null);
          if (!hasAnyDnpPrice) {
            return {
              sku: targetSku,
              error: 'Error de integridad DNP: el SKU existe, pero todas sus columnas de precios están vacías. Se requiere corregir el registro en DNP.',
              source: 'DNP · Error de integridad',
              access: { allowed: false, msg: 'Registro DNP sin precios: requiere corrección' },
              partnerName, partnerLevel, country, region: effectiveRegion
            };
          }

          if (dnpCandidates.length > 0) {

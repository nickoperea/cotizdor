<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#000000" />
  <title>Zebra Price Desk | Intcomex</title>

  <!-- Dependencias externas de React, Babel standalone y bibliotecas de exportación -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg: #F3F5F7;
      --surface: #FFFFFF;
      --surface-2: #F7F9FB;
      --surface-3: #E9EEF3;
      --line: rgba(15, 23, 42, .12);
      --text: #111827;
      --muted: #566170;
      --muted-2: #7B8794;
      --yellow: #0073E6;
      --yellow-hover: #005FBE;
      --blue: #0073E6;
      --green: #278A42;
      --red: #C43D4B;
      --shadow: 0 14px 38px rgba(15, 23, 42, .07);
      color-scheme: light;
    }
    * { box-sizing: border-box; }
    html { min-height: 100%; background: var(--bg); }
    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(circle at 92% -8%, rgba(0,115,230,.07), transparent 27%),
        linear-gradient(180deg, #F8FAFC 0%, #F1F4F7 100%);
      color: var(--text);
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    button, input, textarea, select { font: inherit; }
    button { cursor: pointer; }
    button:disabled { cursor: not-allowed; }
    a { color: inherit; }
    
    /* Layout principal */
    .app-shell { width: 100%; min-height: 100vh; padding-bottom: 38px; background: transparent; }
    .top-alert {
      display: flex; justify-content: center; align-items: center; gap: 9px;
      padding: 9px 16px; background: #000000; color: #FFFFFF;
      text-align: center; font-size: 10px; font-weight: 900;
      letter-spacing: .13em; text-transform: uppercase;
      border-bottom: 3px solid #0073E6;
    }
    .notice-bar {
      display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;
      padding: 12px max(22px, calc((100% - 1320px)/2));
      background: #FFFFFF; border-bottom: 1px solid #E2E7ED;
      color: #343B45; font-size: 11px; font-weight: 600;
    }
    .notice-copy { display: flex; flex-wrap: wrap; gap: 9px; align-items: center; }
    .notice-tag {
      color: #0068D1; border: 1px solid rgba(0,115,230,.22);
      background: rgba(0,115,230,.07); border-radius: 999px;
      padding: 4px 9px; font-size: 9px; font-weight: 900;
      letter-spacing: .08em; text-transform: uppercase;
    }
    .notice-link {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 8px 11px; background: #F1F6FC; border: 1px solid rgba(0,115,230,.2);
      border-radius: 10px; color: #0068D1; text-decoration: none; transition: .18s ease;
    }
    .notice-link:hover { background: #E4F0FC; transform: translateY(-1px); }
    
    /* Encabezado */
    .header { position: relative; z-index: 5; background: rgba(0,0,0,.97); border-bottom: 1px solid rgba(255,255,255,.12); box-shadow: 0 8px 25px rgba(0,0,0,.12); }
    .header-inner { max-width: 1320px; margin: auto; padding: 17px 28px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    .brand { display: flex; align-items: center; gap: 13px; min-width: 0; }
    .brand-name-block { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
    .brand-title { margin: 0; font-size: 19px; line-height: 1.1; font-weight: 900; letter-spacing: -.035em; color: #FFFFFF; }
    .brand-title span { color: #66ABF0; }
    .brand-subtitle { margin: 5px 0 0; color: #B7C0CA; font-size: 9px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
    .header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 12px; }
    .user-block { display: flex; align-items: center; gap: 10px; padding-left: 14px; border-left: 1px solid rgba(255,255,255,.2); }
    .user-meta { text-align: right; }
    .user-meta small { display: block; color: #B7C0CA; font-size: 9px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
    .user-meta strong { display: block; margin-top: 3px; font-size: 11px; color: #FFFFFF; }
    .avatar { width: 35px; height: 35px; display: grid; place-items: center; border-radius: 50%; background: #0073E6; color: #FFFFFF; font-size: 13px; font-weight: 900; }
    
    /* Logos Corporativos */
    .partner-logos { display: inline-flex; align-items: center; gap: 8px; flex: 0 0 auto; margin-left: 3px; }
    .partner-logo-tile {
      height: 44px; min-width: 112px; max-width: 148px; padding: 7px 11px;
      display: inline-flex; align-items: center; justify-content: center; overflow: hidden;
      border: 1px solid #E1E6EC; border-radius: 10px; background: #FFFFFF; box-shadow: 0 2px 8px rgba(0,0,0,.12);
    }
    .partner-logo-tile img { display: block; width: auto; height: auto; max-width: 126px; max-height: 28px; object-fit: contain; }
    .partner-logo-tile.zebra-logo-tile img { max-width: 105px; }
    .partner-logo-tile.intcomex-logo-tile img { max-width: 126px; }
    .partner-logos-divider { color: #AAB4C0; font-size: 14px; font-weight: 800; line-height: 1; }
    .partner-logo-tile.logo-unavailable::after { content: attr(data-fallback); color: #111827; font-size: 10px; font-weight: 900; letter-spacing: .04em; }

    /* Página */
    .page { max-width: 1320px; margin: 0 auto; padding: 30px 28px 28px; }
    .welcome-row { display: flex; justify-content: space-between; align-items: center; gap: 15px; margin-bottom: 22px; }
    .eyebrow { display: flex; align-items: center; gap: 8px; color: #0068D1; font-size: 10px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
    .page-title { margin: 8px 0 5px; font-size: clamp(22px, 3vw, 30px); line-height: 1.1; letter-spacing: -.045em; font-weight: 850; color: #111827; }
    .page-description { margin: 0; color: #657181; font-size: 12px; line-height: 1.65; }
    
    .layout { display: grid; grid-template-columns: minmax(255px, .78fr) minmax(0, 1.75fr); gap: 20px; align-items: start; }
    .sidebar, .content-column { display: grid; gap: 18px; min-width: 0; }
    
    /* Paneles */
    .panel { background: #FFFFFF; border: 1px solid #E0E5EB; border-radius: 18px; box-shadow: 0 10px 30px rgba(15,23,42,.055); }
    .panel-pad { padding: 21px; }
    .panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 17px; }
    .panel-title { display: flex; align-items: center; gap: 9px; margin: 0; color: #151A21; font-size: 11px; font-weight: 900; letter-spacing: .11em; text-transform: uppercase; }
    .panel-title-icon { display: grid; place-items: center; width: 29px; height: 29px; border-radius: 9px; background: #EAF3FD; color: #0073E6; }
    
    .sync-pill {
      display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
      border: 1px solid #CDE8D1; background: #EFF8F0; color: #247A3B;
      border-radius: 999px; padding: 7px 11px; font-size: 10px; font-weight: 800;
      box-shadow: 0 2px 7px rgba(39,138,66,.05);
    }
    .sync-pill.pending { color: #936300; background: #FFF8E6; border-color: #F1D99A; }
    .sync-pill.error { color: #B42332; background: #FFF1F2; border-color: #F2C8CE; }

    /* Botones */
    .sync-button, .secondary-button, .logout-button, .primary-button, .export-button {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      border-radius: 11px; border: 1px solid transparent; font-weight: 850;
      transition: transform .16s ease, background .16s ease, border-color .16s ease;
    }
    .secondary-button { padding: 10px 13px; background: #F1F6FC; border-color: #D6E6F8; color: #0068D1; font-size: 10px; }
    .secondary-button:hover { background: #E4F0FC; transform: translateY(-1px); }
    .logout-button { padding: 9px 11px; background: rgba(255,255,255,.07); border-color: rgba(255,255,255,.18); color: #E5E7EB; font-size: 10px; }
    .logout-button:hover { background: rgba(255,255,255,.14); }
    .export-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
    .export-button { min-height: 44px; padding: 10px; background: #FFFFFF; border-color: #DCE2E8; color: #27313D; font-size: 10px; letter-spacing: .04em; text-transform: uppercase; }
    .export-button:hover { background: #EFF6FD; border-color: #B8D6F5; color: #005FBE; transform: translateY(-1px); }
    .export-button:disabled { opacity: .42; }
    .export-note { margin: 12px 0 0; color: #778392; font-size: 9px; line-height: 1.5; }
    .quick-note { display: flex; align-items: flex-start; gap: 11px; padding: 14px; border-radius: 14px; background: #EEF5FC; border: 1px solid #D5E7F8; color: #34485E; font-size: 10px; line-height: 1.6; }

    /* Formulario de Cotización */
    .quote-panel { overflow: visible; }
    .quote-panel-top { padding: 21px 22px 17px; border-bottom: 1px solid #E6EAF0; }
    .step-label { margin: 0 0 11px; color: #657181; font-size: 9px; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; }
    .segmented-row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; }
    .segmented { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; background: #F0F3F6; border: 1px solid #E0E5EB; border-radius: 13px; }
    .tab-button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 34px; padding: 8px 12px; border: 0; border-radius: 99px; background: transparent; color: #586474; font-size: 9px; font-weight: 850; letter-spacing: .035em; transition: .16s ease; }
    .tab-button:hover { color: #111827; background: #E5EBF1; }
    .tab-button.active { color: #FFFFFF; background: #0073E6; box-shadow: 0 3px 10px rgba(0,115,230,.18); }
    
    .form-body { padding: 22px; }
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .field { min-width: 0; display: grid; gap: 7px; position: relative; }
    .field.full { grid-column: 1 / -1; }
    .field-label { color: #3D4855; font-size: 9px; font-weight: 900; letter-spacing: .105em; text-transform: uppercase; }
    .field-hint { margin: 0 0 0 2px; color: #7B8794; font-size: 9px; line-height: 1.5; }
    .field-input, .field-select, .field-textarea {
      width: 100%; min-width: 0; border: 1px solid #D5DCE4; border-radius: 12px; outline: none;
      background: #FFFFFF; color: #111827; padding: 13px 14px; font-size: 12px; font-weight: 650;
      transition: border-color .16s ease, box-shadow .16s ease, background .16s ease;
    }
    .field-input::placeholder, .field-textarea::placeholder { color: #9AA4B1; font-weight: 550; }
    .field-input:focus, .field-select:focus, .field-textarea:focus { border-color: #0073E6; box-shadow: 0 0 0 3px rgba(0,115,230,.12); background: #FFFFFF; }
    .field-input.error, .field-select.error, .field-textarea.error { border-color: #D94A58; background: #FFF7F7; }
    .field-input.sku { font-size: 15px; font-weight: 850; letter-spacing: .035em; text-transform: uppercase; }
    .field-textarea { min-height: 115px; resize: vertical; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; line-height: 1.7; }
    .field-error { display: flex; align-items: flex-start; gap: 6px; margin: 0 0 0 2px; color: #D94A58; font-size: 9px; font-weight: 750; line-height: 1.5; }
    
    .dropdown { position: absolute; z-index: 20; top: calc(100% + 5px); left: 0; right: 0; max-height: 220px; overflow: auto; padding: 5px; background: #FFFFFF; border: 1px solid #D5DCE4; border-radius: 13px; box-shadow: 0 18px 40px rgba(15,23,42,.15); }
    .dropdown-item { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px; border: 0; border-radius: 8px; background: transparent; color: #18212B; text-align: left; font-size: 10px; font-weight: 750; }
    .dropdown-item:hover { background: #EFF6FD; }
    .dropdown-id { color: #0068D1; font-size: 9px; white-space: nowrap; }
    .partner-selected { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 12px; background: #EFF8F0; border: 1px solid #CDE8D1; border-radius: 11px; color: #28643A; font-size: 9px; }
    
    .primary-button { width: 100%; min-height: 48px; margin-top: 21px; padding: 13px 18px; background: #0073E6; color: #FFFFFF; box-shadow: 0 8px 20px rgba(0,115,230,.18); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }
    .primary-button:hover { background: #005FBE; transform: translateY(-1px); box-shadow: 0 11px 24px rgba(0,115,230,.22); }
    .primary-button:active { transform: translateY(0); }

    /* Resultados de Cotización */
    .result-panel { padding: 22px; }
    .result-topline { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 17px; }
    .result-heading { margin: 0; font-size: 11px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; color: #111827; }
    .result-date { color: #7B8794; font-size: 9px; }
    .result-main { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, .62fr); gap: 18px; align-items: stretch; }
    .result-product { min-width: 0; padding: 4px 0; }
    .badge-row { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 12px; }
    .status-badge { display: inline-flex; align-items: center; gap: 5px; padding: 5px 8px; border-radius: 999px; border: 1px solid #E0E5EB; background: #F4F6F8; color: #46515E; font-size: 8px; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; }
    .status-badge.success { color: #247A3B; background: #EFF8F0; border-color: #CDE8D1; }
    .status-badge.danger { color: #B42332; background: #FFF1F2; border-color: #F2C8CE; }
    .status-badge.promo { color: #0068D1; background: #EAF3FD; border-color: #C9DFF6; }
    .result-sku { margin: 0; overflow-wrap: anywhere; font-size: clamp(19px, 3vw, 27px); font-weight: 900; letter-spacing: -.035em; color: #111827; }
    .result-description { margin: 7px 0 0; color: #647181; font-size: 10px; line-height: 1.6; }
    
    .price-card { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: 19px; border: 1px solid #0073E6; border-radius: 16px; background: linear-gradient(145deg, #101820 0%, #000000 100%); box-shadow: inset 3px 0 0 #0073E6; }
    .price-label { color: #C5CFDA; font-size: 8px; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
    .price-value { margin: 8px 0 0; color: #FFFFFF; font-size: clamp(26px, 3.4vw, 36px); font-weight: 900; line-height: 1; letter-spacing: -.055em; overflow-wrap: anywhere; }
    .price-value span { color: #66ABF0; font-size: 13px; letter-spacing: 0; }
    .promo-line { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-top: 13px; color: #66ABF0; font-size: 9px; font-weight: 800; }
    
    .price-deal-details { display: flex; flex-wrap: wrap; align-items: center; gap: 7px 12px; margin: 12px 0 2px; }
    .price-original { display: inline-flex; align-items: center; gap: 6px; color: #D1D8E0; font-size: 9px; font-weight: 700; }
    .price-original-label { color: #AEB8C4; }
    .price-original-value { color: #D1D8E0; text-decoration: line-through; text-decoration-thickness: 1.5px; text-decoration-color: #F18A8A; opacity: .9; }
    .price-saving-badge { display: inline-flex; align-items: center; gap: 4px; padding: 5px 8px; border: 1px solid rgba(91,190,119,.4); border-radius: 999px; background: rgba(39,138,66,.18); color: #A5E6B4; font-size: 9px; font-weight: 900; white-space: nowrap; }
    .price-final-caption { margin-top: 5px; color: #B7C3D0; font-size: 9px; font-weight: 700; }

    .metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9px; margin-top: 20px; padding-top: 17px; border-top: 1px solid #E5E9EE; }
    .metric { min-width: 0; padding: 12px; background: #F6F8FA; border: 1px solid #E4E8ED; border-radius: 11px; }
    .metric-label { color: #778392; font-size: 8px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
    .metric-value { margin-top: 6px; color: #202A35; font-size: 10px; font-weight: 800; line-height: 1.45; overflow-wrap: anywhere; }
    
    .error-card { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 16px; background: #FFF5F5; border: 1px solid #F2D1D5; border-radius: 14px; }
    .error-message { display: flex; align-items: center; gap: 10px; color: #B42332; font-size: 11px; font-weight: 750; line-height: 1.5; }
    .error-mail { display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 10px 12px; border-radius: 10px; background: #B42332; color: #FFF; font-size: 9px; font-weight: 900; text-decoration: none; white-space: nowrap; }
    .error-mail:hover { background: #981B29; }

    /* Tablas */
    .table-wrap { width: 100%; overflow: auto; border: 1px solid #E0E5EB; border-radius: 13px; }
    .results-table { width: 100%; min-width: 760px; border-collapse: collapse; text-align: left; }
    .results-table th { padding: 12px 11px; background: #000000; color: #FFFFFF; font-size: 8px; font-weight: 900; letter-spacing: .09em; text-transform: uppercase; white-space: nowrap; border-bottom: 2px solid #0073E6; }
    .results-table td { padding: 12px 11px; border-top: 1px solid #E9EDF2; background: #FFFFFF; color: #394553; font-size: 9px; font-weight: 700; vertical-align: middle; }
    .results-table tbody tr:hover td { background: #F3F8FD; }
    .results-table tbody tr.row-error td { background: #FFF7F7; }
    .text-right { text-align: right !important; }
    .text-center { text-align: center !important; }
    .sku-cell { color: #151A21 !important; font-weight: 900 !important; }
    .sub-cell { display: block; margin-top: 4px; color: #7B8794; font-size: 8px; }
    .table-promo { color: #0068D1 !important; font-size: 8px !important; font-weight: 900 !important; }
    .table-old-value { color: #8793A1; font-size: 8px; text-decoration: line-through; text-decoration-color: #D66C75; text-decoration-thickness: 1.25px; }
    .table-saving-value { color: #247A3B !important; font-weight: 900 !important; white-space: nowrap; }
    .table-final-value { color: #111827 !important; font-weight: 900 !important; white-space: nowrap; }

    .empty-state { display: flex; align-items: center; gap: 13px; padding: 17px; border: 1px dashed #CBD6E2; border-radius: 14px; background: rgba(255,255,255,.72); color: #687585; font-size: 10px; line-height: 1.6; }
    .empty-icon { width: 35px; height: 35px; display: grid; place-items: center; flex: 0 0 auto; border-radius: 11px; background: #EAF3FD; color: #0073E6; }

    /* Login */
    .login-screen { min-height: 100vh; display: grid; place-items: center; padding: 25px; background: radial-gradient(circle at 18% 12%, rgba(0,115,230,.09), transparent 30%), linear-gradient(180deg, #F8FAFC, #EEF2F6); }
    .login-card { width: min(100%, 420px); padding: 30px; background: #FFFFFF; border: 1px solid #E0E5EB; border-radius: 25px; box-shadow: 0 24px 70px rgba(15,23,42,.12); }
    .login-brand { text-align: center; margin-bottom: 27px; }
    .login-partner-logos { display: flex; justify-content: center; margin: 0 auto 20px; }
    .login-partner-logos .partner-logos { margin-left: 0; }
    .login-partner-logos .partner-logo-tile { box-shadow: 0 2px 8px rgba(15,23,42,.07); }
    .login-title { margin: 0; font-size: 25px; font-weight: 900; letter-spacing: -.055em; color: #111827; }
    .login-title span { color: #0073E6; }
    .login-subtitle { margin: 8px 0 0; color: #6B7785; font-size: 9px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
    .internal-tag { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; padding: 6px 10px; border: 1px solid #D6E6F8; border-radius: 999px; background: #EFF6FD; color: #0068D1; font-size: 8px; font-weight: 900; letter-spacing: .09em; text-transform: uppercase; }
    .login-form { display: grid; gap: 16px; }
    .login-submit { margin-top: 3px; }
    .login-error { display: flex; align-items: flex-start; gap: 9px; padding: 12px; border: 1px solid rgba(251,113,133,.2); border-radius: 11px; background: rgba(127,29,29,.16); color: #fda4af; font-size: 10px; font-weight: 700; line-height: 1.5; }
    .login-help { margin: 17px 0 0; color: #7B8794; font-size: 9px; line-height: 1.6; text-align: center; }
    .footer-note { margin: 22px 0 0; color: #8994A1; text-align: center; font-size: 8px; letter-spacing: .08em; text-transform: uppercase; }

    /* Admin Center Dashboard */
    .module-nav { display: flex; gap: 8px; margin: -5px 0 20px; padding: 5px; width: max-content; max-width: 100%; background: #F0F3F6; border: 1px solid #E0E5EB; border-radius: 13px; }
    .module-nav-button { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 9px 14px; border: 0; border-radius: 9px; background: transparent; color: #586474; font-size: 10px; font-weight: 850; transition: .16s ease; }
    .module-nav-button:hover { color: #111827; background: #E5EBF1; }

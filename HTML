      const partnerList = useMemo(() => {
        if (!partnerLevelData || partnerLevelData.length === 0) return [];
        const list = [];
        const seenKeys = new Set();
        partnerLevelData.forEach(p => {
          if (!p) return;
          const name = (p['B'] || p['col_1'] || p['Partner'] || p['Partner Name'] || p['Account Name'] || p['Company'] || p['Nombre'] || '').toString().trim();
          let id = (p['A'] || p['col_0'] || p['Partner Program ID Number'] || p['ID'] || '').toString().trim();
          if (!id) {
            const foundId = Object.values(p).find(v => v && /^\d{3,8}$/.test(v.toString().trim()));
            if (foundId) id = foundId.toString().trim();
          }
          const cleanName = name.toUpperCase();
          if (!name || cleanName.includes('POR DEFINIR') || cleanName === 'N/A' || cleanName === 'NAME') return;
          const uniqueKey = `${id}-${cleanName}`;
          if (!seenKeys.has(uniqueKey)) { seenKeys.add(uniqueKey); list.push({ id, name, raw: p }); }
        });
        return list.sort((a,b) => a.name.localeCompare(b.name));

                          <tbody>
                            {bulkResults.map((res, i) => (
                              <tr key={`${res.sku}-${i}`} className={!res.access?.allowed ? 'row-error' : ''}>
                                <td><span className={`status-badge ${res.access?.allowed ? 'success' : 'danger'}`}>{res.access?.allowed ? 'Venta permitida' : (res.access?.msg || 'No disponible')}</span></td>
                                <td className="sku-cell">{res.sku}<span className="sub-cell">Code: {res.rawAccessCode || 'N/A'}</span>{res.error && <span className="sub-cell">{res.error}</span>}</td>
                                
                                {/* NUEVA CELDA DE EMPAQUE */}
                                <td className="text-center">
                                  {res.boxQty > 1 ? <span style={{fontSize: '8px', fontWeight: 800, color: '#92400e', background: '#fef3c7', padding: '3px 6px', borderRadius: '4px'}}>Caja x {res.boxQty}</span> : <span style={{fontSize: '8px', color: '#7B8794'}}>Unidad</span>}
                                </td>

                                <td className="text-right">{res.basePrice == null ? '—' : <span className="table-old-value">${(Number(res.basePrice) || 0).toFixed(2)}</span>}</td>
                                <td className="text-right">{Number(res.discountApplied) > 0 ? <span className="table-saving-value">−${Number(res.discountApplied).toFixed(2)}</span> : '—'}</td>
                                <td className="text-center table-promo">{res.promoCode || 'Sin Promo'}</td>
                                
                                {/* CELDA DE PRECIO FINAL POR CAJA */}
                                <td className="text-right"><span className="table-final-value">{res.boxTotal == null ? '—' : `$${(Number(res.boxTotal) || 0).toFixed(2)}`}</span></td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </section>
                  )}

                  {!searchResult && bulkResults.length === 0 && (
                    <div className="empty-state">
                      <div className="empty-icon"><Icon name="layers" size={18}/></div>
                      <span>Cuando proceses una cotización, el resultado aparecerá aquí con el precio final, la promoción aplicada y la validación de acceso.</span>
                    </div>
                  )}
                </section>
              </div>
            )}

            {activeModule === 'admin' && isAdminUser && (
              <div className="admin-center">
                <div className="admin-subnav" role="tablist" aria-label="Secciones de administración">
                  <button type="button" role="tab" aria-selected={adminSection === 'dashboard'} className={adminSection === 'dashboard' ? 'active' : ''} onClick={() => setAdminSection('dashboard')}><Icon name="layout-dashboard" size={14}/> Dashboard</button>
                  <button type="button" role="tab" aria-selected={adminSection === 'promotions'} className={adminSection === 'promotions' ? 'active' : ''} onClick={() => setAdminSection('promotions')}><Icon name="tag" size={14}/> Gestión de promociones</button>
                </div>
                {adminSection === 'dashboard' && (
                <>
                <section className="admin-hero panel">
                  <div className="admin-hero-copy">
                    <div className="eyebrow"><Icon name="layout-dashboard" size={13}/> Inteligencia comercial · Analítica de uso</div>
                    <h3>Dashboard de gestión comercial</h3>
                    <p>Entiende cómo se utiliza Zebra Price Desk, qué productos y partners concentran las consultas, qué promociones generan movimiento y dónde aparecen restricciones o faltantes de precio.</p>
                  </div>
                  <div className="admin-hero-actions">
                    <button className="secondary-button" onClick={refreshAnalytics} disabled={analyticsLoading}><Icon name="refresh" size={14}/> {analyticsLoading ? 'Actualizando...' : 'Actualizar dashboard'}</button>
                    <button className="primary-button admin-export-button" onClick={exportAnalytics} disabled={!filteredAnalytics.length}><Icon name="file" size={14}/> Exportar Excel</button>
                  </div>
                </section>

                <section className={`admin-source-note ${ANALYTICS_API_URL ? '' : 'local'}`}>
                  <Icon name={ANALYTICS_API_URL ? 'database' : 'info'} size={16}/>
                  <span><strong>{ANALYTICS_API_URL ? 'Registro central habilitado.' : 'Modo local de analítica.'}</strong> {analyticsMessage || (ANALYTICS_API_URL ? 'Los eventos se consolidan desde el registro compartido.' : 'Los datos se guardan en este navegador. Para consolidar actividad de todo el equipo, implementa el Apps Script incluido y pega su URL en ANALYTICS_API_URL.')}</span>
                </section>

                <div className="admin-controls">
                  <div><div className="panel-title"><span className="panel-title-icon"><Icon name="calendar" size={15}/></span> Periodo de análisis</div></div>
                  <select className="admin-filter" value={analyticsPeriod} onChange={e => setAnalyticsPeriod(e.target.value)}>
                    <option value="7">Últimos 7 días</option>
                    <option value="30">Últimos 30 días</option>
                    <option value="90">Últimos 90 días</option>
                    <option value="all">Histórico completo</option>
                  </select>
                </div>

                <div className="admin-stat-grid">
                  <div className="admin-stat panel"><span className="admin-stat-icon"><Icon name="file" size={17}/></span><div className="admin-stat-value">{analyticsSummary.quotes.toLocaleString('es-CO')}</div><div className="admin-stat-label">Cotizaciones generadas</div></div>
                  <div className="admin-stat panel"><span className="admin-stat-icon"><Icon name="search" size={17}/></span><div className="admin-stat-value">{analyticsSummary.skuQueries.toLocaleString('es-CO')}</div><div className="admin-stat-label">SKUs consultados</div></div>
                  <div className="admin-stat panel"><span className="admin-stat-icon"><Icon name="users" size={17}/></span><div className="admin-stat-value">{analyticsSummary.partners.toLocaleString('es-CO')}</div><div className="admin-stat-label">Partners cotizados</div></div>
                  <div className="admin-stat panel"><span className="admin-stat-icon"><Icon name="tag" size={17}/></span><div className="admin-stat-value">{analyticsSummary.promoUses.toLocaleString('es-CO')}</div><div className="admin-stat-label">Promociones utilizadas</div></div>
                  <div className="admin-stat panel"><span className="admin-stat-icon"><Icon name="dollar-sign" size={17}/></span><div className="admin-stat-value" style={{fontSize:19}}>{formatMoney(analyticsSummary.discounts)}</div><div className="admin-stat-label">Descuentos otorgados · USD</div></div>
                  <div className="admin-stat panel"><span className="admin-stat-icon danger"><Icon name="shield-alert" size={17}/></span><div className="admin-stat-value">{analyticsSummary.blocked.toLocaleString('es-CO')}</div><div className="admin-stat-label">Consultas bloqueadas por acceso</div></div>
                  <div className="admin-stat panel"><span className="admin-stat-icon warning"><Icon name="package-x" size={17}/></span><div className="admin-stat-value">{analyticsSummary.noPrice.toLocaleString('es-CO')}</div><div className="admin-stat-label">SKUs únicos sin precio asignable</div></div>
                  <div className="admin-stat panel"><span className="admin-stat-icon"><Icon name="user-check" size={17}/></span><div className="admin-stat-value">{analyticsSummary.users.toLocaleString('es-CO')}</div><div className="admin-stat-label">Usuarios con actividad</div></div>
                </div>

                <div className="admin-grid-two">
                  <section className="panel admin-panel">
                    <div className="admin-panel-heading"><div><h3 className="panel-title"><span className="panel-title-icon"><Icon name="trending-up" size={15}/></span> SKUs más consultados</h3><p className="admin-panel-subtitle">Productos con mayor interés en el periodo</p></div></div>
                    {analyticsSummary.topSkus.length ? <div className="table-wrap admin-table-wrap"><table className="admin-table"><thead><tr><th>SKU</th><th className="text-right">Consultas</th></tr></thead><tbody>{analyticsSummary.topSkus.map(row => <tr key={row.name}><td className="primary-cell">{row.name}</td><td className="text-right">{row.count}</td></tr>)}</tbody></table></div> : <div className="admin-empty"><Icon name="bar-chart" size={20}/> Aún no hay consultas registradas para este periodo.</div>}
                  </section>
                  <section className="panel admin-panel">
                    <div className="admin-panel-heading"><div><h3 className="panel-title"><span className="panel-title-icon"><Icon name="building-2" size={15}/></span> Partners más cotizados</h3><p className="admin-panel-subtitle">Actividad comercial por partner</p></div></div>
                    {analyticsSummary.topPartners.length ? <div className="table-wrap admin-table-wrap"><table className="admin-table"><thead><tr><th>Partner</th><th className="text-right">Cotizaciones</th></tr></thead><tbody>{analyticsSummary.topPartners.map(row => <tr key={row.name}><td className="primary-cell">{row.name}</td><td className="text-right">{row.count}</td></tr>)}</tbody></table></div> : <div className="admin-empty"><Icon name="users" size={20}/> Aún no hay partners cotizados registrados.</div>}
                  </section>
                  <section className="panel admin-panel">
                    <div className="admin-panel-heading"><div><h3 className="panel-title"><span className="panel-title-icon"><Icon name="tag" size={15}/></span> Promociones con más movimiento</h3><p className="admin-panel-subtitle">Cantidad de SKU cotizados con cada incentivo</p></div></div>
                    {analyticsSummary.topPromos.length ? <div className="table-wrap admin-table-wrap"><table className="admin-table"><thead><tr><th>Promoción</th><th className="text-right">Usos</th></tr></thead><tbody>{analyticsSummary.topPromos.map(row => <tr key={row.name}><td className="primary-cell">{row.name}</td><td className="text-right">{row.count}</td></tr>)}</tbody></table></div> : <div className="admin-empty"><Icon name="tag" size={20}/> Todavía no se han registrado promociones utilizadas.</div>}
                  </section>
                  <section className="panel admin-panel">
                    <div className="admin-panel-heading"><div><h3 className="panel-title"><span className="panel-title-icon"><Icon name="users" size={15}/></span> Actividad por usuario</h3><p className="admin-panel-subtitle">Cotizaciones generadas por cada integrante</p></div></div>
                    {analyticsSummary.activity.length ? <div className="table-wrap admin-table-wrap"><table className="admin-table"><thead><tr><th>Usuario</th><th className="text-right">Cotizaciones</th></tr></thead><tbody>{analyticsSummary.activity.map(row => <tr key={row.name}><td className="primary-cell">{row.name}</td><td className="text-right">{row.count}</td></tr>)}</tbody></table></div> : <div className="admin-empty"><Icon name="user" size={20}/> Aún no hay actividad de usuarios registrada.</div>}
                  </section>
                  <section className="panel admin-panel">
                    <div className="admin-panel-heading"><div><h3 className="panel-title"><span className="panel-title-icon"><Icon name="package-x" size={15}/></span> SKUs sin precio asignable</h3><p className="admin-panel-subtitle">Referencias encontradas sin precio aplicable en las bases</p></div></div>
                    {analyticsSummary.noPriceRows.length ? <div className="table-wrap admin-table-wrap"><table className="admin-table"><thead><tr><th>SKU</th><th className="text-right">Intentos</th></tr></thead><tbody>{analyticsSummary.noPriceRows.map(row => <tr key={row.name}><td className="primary-cell">{row.name}</td><td className="text-right">{row.count}</td></tr>)}</tbody></table></div> : <div className="admin-empty"><Icon name="check-circle" size={20}/> No hay SKUs sin precio asignable en este periodo.</div>}
                  </section>
                  <section className="panel admin-panel">
                    <div className="admin-panel-heading"><div><h3 className="panel-title"><span className="panel-title-icon"><Icon name="shield-alert" size={15}/></span> Motivos de consulta bloqueada</h3><p className="admin-panel-subtitle">Restricciones de acceso detectadas durante las cotizaciones</p></div></div>
                    {analyticsSummary.blockedRows.length ? <div className="table-wrap admin-table-wrap"><table className="admin-table"><thead><tr><th>Motivo</th><th className="text-right">Eventos</th></tr></thead><tbody>{analyticsSummary.blockedRows.map(row => <tr key={row.name}><td>{row.name}</td><td className="text-right">{row.count}</td></tr>)}</tbody></table></div> : <div className="admin-empty"><Icon name="check-circle" size={20}/> No se han registrado restricciones de acceso en este periodo.</div>}
                  </section>
                </div>

                <section className="panel admin-panel">
                  <div className="admin-panel-heading"><div><h3 className="panel-title"><span className="panel-title-icon"><Icon name="database" size={15}/></span> Alcance y calidad de la medición</h3><p className="admin-panel-subtitle">Los eventos se generan al procesar una cotización individual o masiva.</p></div></div>
                  <div className="admin-method-grid">
                    <div><strong>Cotizaciones y SKUs</strong><p>Una cotización cuenta cada procesamiento; cada referencia procesada se registra como un SKU consultado.</p></div>
                    <div><strong>Descuentos y promociones</strong><p>Se suman los descuentos calculados por el motor actual y se contabilizan los códigos promocionales realmente aplicados.</p></div>
                    <div><strong>Restricciones y faltantes</strong><p>Se separan los bloqueos por reglas de acceso, los SKU encontrados sin precio y los SKU que no aparecen en las bases.</p></div>
                  </div>
                  <p className="admin-security-note"><Icon name="lock" size={13}/> El dashboard es visible únicamente cuando el rol del usuario está marcado como ‘Administrador’ en la columna D de la hoja de usuarios.</p>
                </section>
                </>
                )}
                {adminSection === 'promotions' && (
                  <>
                    <section className="admin-hero panel">
                      <div className="admin-hero-copy">
                        <div className="eyebrow"><Icon name="tag" size={13}/> Administración comercial · Zebra</div>
                        <h3>Gestión de promociones</h3>
                        <p>Administra las reglas promocionales desde Zebra Price Desk. Los cambios se validan y guardan en la matriz oficial de Google Sheets.</p>
                      </div>
                      <div className="admin-hero-actions">
                        <button className="secondary-button" onClick={syncDataFromDrive} disabled={loadingDrive}><Icon name="refresh" size={14}/> {loadingDrive ? 'Sincronizando...' : 'Actualizar promociones'}</button>
                      </div>
                    </section>
                    {!promoAdminUnlocked ? (
                      <section className="panel admin-panel promo-crud-card">
                        <div className="admin-panel-heading"><div><h3 className="panel-title">Acceso de administración</h3><p className="admin-panel-subtitle">Ingresa la clave administrativa para gestionar las reglas promocionales.</p></div></div>
                        <div className="promo-crud-access">
                          <input className="promo-filter-input" type="password" autoComplete="current-password" aria-label="Clave administrativa" value={promoAdminKey} onChange={e => setPromoAdminKey(e.target.value)} onKeyDown={e => {if(e.key === 'Enter') unlockPromotionAdmin();}} placeholder="Escribe aquí la clave administrativa"/>
                          <button type="button" className="primary-button" onClick={unlockPromotionAdmin} disabled={promoCrudLoading}>{promoCrudLoading ? 'Verificando...' : 'Desbloquear gestión'}</button>
                        </div>
                        {promoCrudMessage && <p className={'promo-crud-message ' + (promoCrudError ? 'error' : '')}>{promoCrudMessage}</p>}
                      </section>
                    ) : (
                      <section className="panel admin-panel promo-crud-card">
                        <div className="admin-panel-heading">
                          <div><h3 className="panel-title">{promoEditingId ? 'Editar promoción' : 'Crear promoción'}</h3><p className="admin-panel-subtitle">Los cambios se guardan directamente en la hoja oficial. La clave permanece solo en memoria.</p></div>
                          <button type="button" className="secondary-button" onClick={() => {setPromoAdminUnlocked(false);setPromoAdminKey('');resetPromotionForm();setPromoCrudMessage('Sesión administrativa cerrada.');}}>Bloquear gestión</button>
                        </div>
                        <form className="promo-crud-grid" onSubmit={savePromotion}>
                          <label>Código de promoción<input className="promo-filter-input" value={promoForm.codigo} onChange={e=>setPromoForm(v=>({...v,codigo:e.target.value}))} required placeholder="Ej. ZD220T3HWA26"/></label>
                          <label>Regiones (separadas por coma)<input className="promo-filter-input" value={promoForm.region} onChange={e=>setPromoForm(v=>({...v,region:e.target.value.toUpperCase()}))} required placeholder="COLOMBIA, NOLA"/></label>
                          <label>Tipo de coincidencia<select className="promo-filter-input" value={promoForm.tipoCoincidencia} onChange={e=>setPromoForm(v=>({...v,tipoCoincidencia:e.target.value}))}><option value="EXACTO">SKU exacto</option><option value="PREFIJO">Prefijo</option></select></label>
                          <label className="promo-crud-wide">SKU o patrón <span style={{fontWeight:500,color:'#7B8794'}}>Puedes ingresar varios, separados por comas</span><textarea className="promo-filter-input" rows="3" value={promoForm.patronSKU} onChange={e=>setPromoForm(v=>({...v,patronSKU:e.target.value}))} required placeholder={'SKU1, SKU2, SKU3'} /></label>
                          <label>Tipo de descuento<select className="promo-filter-input" value={promoForm.tipoDescuento} onChange={e=>setPromoForm(v=>({...v,tipoDescuento:e.target.value}))}><option value="FIJO">Valor fijo (USD)</option><option value="PORCENTAJE">Porcentaje</option></select></label>
                          <label>Valor del descuento<input className="promo-filter-input" type="number" min="0.01" step="0.01" value={promoForm.valorDescuento} onChange={e=>setPromoForm(v=>({...v,valorDescuento:e.target.value}))} required placeholder={promoForm.tipoDescuento==='PORCENTAJE'?'Ej. 3':'Ej. 15'}/></label>
                          <label>Fecha de inicio<input className="promo-filter-input" type="date" value={promoForm.fechaInicio} onChange={e=>setPromoForm(v=>({...v,fechaInicio:e.target.value}))}/></label>
                          <label>Fecha de fin<input className="promo-filter-input" type="date" value={promoForm.fechaFin} onChange={e=>setPromoForm(v=>({...v,fechaFin:e.target.value}))}/></label>
                          <label className="promo-crud-check"><input type="checkbox" checked={promoForm.activa} onChange={e=>setPromoForm(v=>({...v,activa:e.target.checked}))}/> Promoción activa</label>
                          <label className="promo-crud-check"><input type="checkbox" checked={promoForm.excluirDNP} onChange={e=>setPromoForm(v=>({...v,excluirDNP:e.target.checked}))}/> Excluir SKU incluido en DNP</label>
                          <label className="promo-crud-wide">Observaciones<textarea className="promo-filter-input" rows="2" value={promoForm.observaciones} onChange={e=>setPromoForm(v=>({...v,observaciones:e.target.value}))} placeholder="Condiciones o notas internas"/></label>
                          <div className="promo-crud-actions promo-crud-wide">
                            <button type="submit" className="primary-button" disabled={promoCrudLoading}>{promoCrudLoading ? 'Guardando...' : promoEditingId ? 'Guardar cambios' : 'Crear promoción'}</button>
                            {promoEditingId && <button type="button" className="secondary-button" onClick={resetPromotionForm} disabled={promoCrudLoading}>Cancelar edición</button>}
                          </div>
                        </form>
                        {promoCrudMessage && <p className={'promo-crud-message ' + (promoCrudError ? 'error' : '')}>{promoCrudMessage}</p>}
                      </section>
                    )}
                    <div className="promo-summary-grid">
                      <section className="panel promo-summary-card"><div className="admin-stat-label">Reglas cargadas</div><div className="promo-summary-value">{promotionCounts.total}</div><div className="promo-summary-label">Desde la matriz de Google Sheets</div></section>
                      <section className="panel promo-summary-card"><div className="admin-stat-label">Promociones activas</div><div className="promo-summary-value">{promotionCounts.active}</div><div className="promo-summary-label">Dentro de su periodo de vigencia</div></section>
                      <section className="panel promo-summary-card"><div className="admin-stat-label">No activas / fuera de vigencia</div><div className="promo-summary-value">{promotionCounts.inactive}</div><div className="promo-summary-label">Inactivas, programadas o vencidas</div></section>
                    </div>
                    <section className="panel admin-panel">
                      <div className="admin-panel-heading">
                        <div><h3 className="panel-title"><span className="panel-title-icon"><Icon name="filter" size={15}/></span> Buscar y filtrar reglas</h3><p className="admin-panel-subtitle">Busca por código, SKU, prefijo, región u observación</p></div>
                        <span className="sync-pill">{filteredPromotionRows.length} de {promotionRows.length}</span>
                      </div>
                      <div className="promo-filter-row">
                        <input className="promo-filter-input" value={promotionSearch} onChange={e => setPromotionSearch(e.target.value)} placeholder="Buscar código o SKU..."/>
                        <select className="promo-filter-input" value={promotionRegionFilter} onChange={e => setPromotionRegionFilter(e.target.value)}>
                          <option value="TODAS">Todas las regiones</option><option value="COLOMBIA">Colombia</option><option value="SOLA">SOLA</option><option value="NOLA">NOLA</option>
                        </select>
                        <select className="promo-filter-input" value={promotionStatusFilter} onChange={e => setPromotionStatusFilter(e.target.value)}>
                          <option value="TODAS">Todos los estados</option><option value="ACTIVA">Activas</option><option value="INACTIVA">Inactivas</option><option value="PROGRAMADA">Programadas</option><option value="VENCIDA">Vencidas</option>
                        </select>
                      </div>
                      <div className="table-wrap admin-table-wrap" style={{marginTop:14}}>
                        <table className="admin-table promo-table">
                          <thead><tr><th>Código</th><th>Región</th><th>Coincidencia</th><th>SKU / prefijo</th><th>Descuento</th><th>Vigencia</th><th>Estado</th><th>Condiciones</th>{promoAdminUnlocked && <th>Acciones</th>}</tr></thead>
                          <tbody>
                            {filteredPromotionRows.map(row => (
                              <tr key={row.id}>
                                <td className="promo-code">{row.code}</td><td>{row.region}</td><td>{row.matchType}</td><td className="primary-cell">{row.pattern}</td>
                                <td>{row.discountValue === null ? '—' : row.discountType === 'PORCENTAJE' ? row.discountValue + '%' : '$' + row.discountValue.toFixed(2) + ' USD'}</td>
                                <td>{row.startDate || row.endDate ? (row.startDate ? row.startDate.toLocaleDateString('es-CO') : 'Sin inicio') + ' – ' + (row.endDate ? row.endDate.toLocaleDateString('es-CO') : 'Sin fin') : 'Sin fechas definidas'}</td>
                                <td><span className={'promo-status ' + (row.status === 'Activa' ? 'active' : row.status === 'Programada' ? 'scheduled' : row.status === 'Vencida' ? 'expired' : 'inactive')}>{row.status}</span></td>
                                <td>{row.excludeDnp ? 'Excluye DNP' : '—'}{row.notes && <span className="promo-observation" title={row.notes}>{row.notes}</span>}</td>{promoAdminUnlocked && <td><div className="promo-row-actions"><button type="button" className="promo-crud-action" onClick={()=>editPromotion(row)} disabled={promoCrudLoading}>Editar</button><button type="button" className="promo-crud-action" onClick={()=>togglePromotion(row)} disabled={promoCrudLoading}>{row.enabled ? 'Desactivar' : 'Activar'}</button><button type="button" className="promo-crud-action danger" onClick={()=>deletePromotion(row)} disabled={promoCrudLoading}>Eliminar</button></div></td>}
                              </tr>
                            ))}
                            {!filteredPromotionRows.length && <tr><td colSpan={promoAdminUnlocked ? 9 : 8}><div className="admin-empty"><Icon name="search" size={18}/> No hay promociones que coincidan con los filtros seleccionados.</div></td></tr>}
                          </tbody>
                        </table>
                      </div>
                      <p className="admin-security-note"><Icon name="shield" size={13}/> Los cambios administrativos requieren la clave privada de Apps Script. La consulta y el motor de precios conservan su funcionamiento actual.</p>
                    </section>
                  </>
                )}
              </div>
            )}
            <p className="footer-note">Zebra Price Desk · Intcomex · Uso interno</p>
            <p className="footer-note" style={{marginTop: 5}}>Creado por: Nicolás Perea</p>
          </main>
        </div>
      );
    };

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<ErrorBoundary><App /></ErrorBoundary>);
  </script>
</body>
</html>

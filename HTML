<body>
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useRef, useMemo } = React;

    // ============================================================
    // MOTOR DE COTIZACIÓN Y CONFIGURACIÓN DE HOJAS
    // ============================================================
    const DEFAULT_DNP_SHEET_ID = '1zrOWRApHFE64PBqvdR1iYqykK1N66I9IEmCBsdDL6_k&gid=282922731';
    const DEFAULT_PRICE_LIST_SHEET_ID = '1T8HYEMYA7urr1UOqIoO28YH4lcoUeUySePH0sdMLnJs&gid=487842778';
    const DEFAULT_PARTNER_LEVEL_SHEET_ID = '1GWcWQHs535jGzodQFjQaoUn_WNc8vgmZ_GWnQYck5mQ&gid=399237021';
    const DEFAULT_USERS_SHEET_ID = '1z_-VWCunuX4fNa6FEBQ2IT4bmtWAdC6VVKSc2ztL7IE';
    const DEFAULT_PROMOTIONS_SHEET_ID = '1Iw6TYWQ9oHSqISxvsjGkhx9kGFRNAsgh8U3oblIZQ0E';

    const clean = (text) => text?.toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toUpperCase() || '';
    
    const parsePrice = (val) => {
      if (val === null || val === undefined || val === 'N/A' || val === '') return null;
      if (typeof val === 'number') return val;
      const cleaned = val.toString().replace(/,/g, '').replace(/[^\d.-]/g, '');
      const num = parseFloat(cleaned);
      return isNaN(num) ? null : num;
    };

    const getRegionForCountry = (country) => {
      const c = clean(country);
      if (c === 'COLOMBIA') return 'Colombia';
      if (['PERU', 'PERÚ', 'CHILE', 'ARGENTINA', 'URUGUAY', 'BOLIVIA', 'PARAGUAY', 'SOLA'].includes(c)) return 'SOLA';
      return 'NOLA';
    };

    const getFlexibleValue = (obj, targetKey) => {
      if (!obj || !targetKey) return null;
      const target = clean(targetKey);
      const keys = Object.keys(obj);
      const exact = keys.find(k => clean(k) === target);
      if (exact) return obj[exact];
      if (target.includes('REGISTER')) {
        const regKey = keys.find(k => clean(k).includes('REGISTER'));
        if (regKey) return obj[regKey];
      }
      const contains = keys.find(k => clean(k).includes(target));
      if (contains) return obj[contains];
      const isContained = keys.find(k => {
        const kc = clean(k);
        return kc.length > 5 && target.includes(kc);
      });
      if (isContained) return obj[isContained];
      return null;
    };

    // ============================================================
    // ANALÍTICA DE COTIZACIONES Y ACTIVIDAD COMERCIAL
    // ============================================================
    const ANALYTICS_API_URL = 'https://script.google.com/macros/s/AKfycbyAsqGY809-ijPAuRpH50lmVrJxV_EQ-_xn4PX8YKeW8pboBz-0LFFJdfkBuH5M36H2yA/exec';
    const ANALYTICS_STORAGE_KEY = 'zebra_price_desk_analytics_v1';
    
    const readLocalAnalytics = () => {
      try {
        return JSON.parse(localStorage.getItem(ANALYTICS_STORAGE_KEY) || '[]');
      } catch (e) {
        return [];
      }
    };
    
    const saveLocalAnalytics = (events) => {
      try {
        const existing = readLocalAnalytics();
        const merged = [...existing, ...events].slice(-5000);
        localStorage.setItem(ANALYTICS_STORAGE_KEY, JSON.stringify(merged));
      } catch (e) {
        console.warn('No fue posible guardar analítica local:', e);
      }
    };
    
    const sendAnalyticsEvents = (events, username) => {
      if (!events?.length) return;
      saveLocalAnalytics(events);
      if (!ANALYTICS_API_URL) return;
      fetch(ANALYTICS_API_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({ action: 'append', username, events })
      }).catch(err => console.warn('No fue posible enviar analítica central:', err));
    };

    const fetchCentralAnalytics = (username) => new Promise((resolve, reject) => {
      if (!ANALYTICS_API_URL) return reject(new Error('Endpoint de analítica no configurado'));
      const callbackName = `__zpdAnalytics_${Date.now()}_${Math.floor(Math.random()*100000)}`;
      const script = document.createElement('script');
      const cleanup = () => { try { delete window[callbackName]; } catch(e) { window[callbackName] = undefined; } script.remove(); };
      const timeout = setTimeout(() => { cleanup(); reject(new Error('Tiempo de espera agotado al consultar analítica')); }, 15000);
      window[callbackName] = payload => { clearTimeout(timeout); cleanup(); payload?.ok ? resolve(payload.events || []) : reject(new Error(payload?.error || 'No fue posible leer analítica')); };
      script.onerror = () => { clearTimeout(timeout); cleanup(); reject(new Error('No fue posible conectar con Apps Script')); };
      script.src = `${ANALYTICS_API_URL}${ANALYTICS_API_URL.includes('?') ? '&' : '?'}action=read&username=${encodeURIComponent(username)}&callback=${callbackName}&_=${Date.now()}`;
      document.head.appendChild(script);
    });

    const formatMoney = value => '$' + (Number(value) || 0).toLocaleString('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USD';
    const getAnalyticsDate = event => {
      const value = event.timestamp || event.fecha || event.Fecha || '';
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? null : date;
    };

    // MOTOR DE PROMOCIONES: reglas administradas desde Google Sheets
    const parsePromotionDate = value => {
      if (value === null || value === undefined || value === '') return null;
      if (value instanceof Date) return new Date(value.getFullYear(), value.getMonth(), value.getDate());
      const raw = String(value).trim();
      const gvizDate = raw.match(/^Date\((\d+),(\d+),(\d+)\)$/);
      if (gvizDate) return new Date(Number(gvizDate[1]), Number(gvizDate[2]), Number(gvizDate[3]));
      const parsed = new Date(raw);
      return Number.isNaN(parsed.getTime()) ? null : new Date(parsed.getFullYear(), parsed.getMonth(), parsed.getDate());
    };

    const isSheetTrue = value => value === true || ['TRUE', 'VERDADERO', 'SI', 'SÍ', '1', 'ACTIVA'].includes(clean(value));

    const evaluatePromotions = (sku, region, country, basePrice, isDnpSku = false, promotionsData = []) => {
      const s = clean(sku);
      const reg = clean(region || getRegionForCountry(country));
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      const matches = (promotionsData || []).filter(row => {
        const code = String(row['B'] || row['col_1'] || '').trim();
        const ruleRegion = String(row['C'] || row['col_2'] || '').trim();
        const matchType = clean(row['D'] || row['col_3'] || '');
        const patterns = String(row['E'] || row['col_4'] || '').split(',').map(clean).filter(Boolean);
        const discountType = clean(row['F'] || row['col_5'] || '');
        const active = isSheetTrue(row['J'] ?? row['col_9']);
        const excludeDnp = isSheetTrue(row['K'] ?? row['col_10']);
        if (!code || !patterns.length || !active) return false;
        if (excludeDnp && isDnpSku) return false;
        const regions = ruleRegion.split(',').map(clean).filter(Boolean);
        if (!regions.includes(reg)) return false;
        const skuMatches = matchType === 'EXACTO'
          ? patterns.some(pattern => s === pattern)
          : matchType === 'PREFIJO'
            ? patterns.some(pattern => s.startsWith(pattern))
            : false;
        if (!skuMatches) return false;

        const startDate = parsePromotionDate(row['H'] ?? row['col_7']);
        const endDate = parsePromotionDate(row['I'] ?? row['col_8']);
        if (startDate && today < startDate) return false;
        if (endDate && today > endDate) return false;
        return discountType === 'FIJO' || discountType === 'PORCENTAJE';
      });

      if (!matches.length) {
        return { finalPrice: Math.max(0, basePrice), promoCode: 'Sin Promo', discountApplied: 0 };
      }

      // Conserva la primera regla coincidente según el orden de la matriz.
      const rule = matches[0];
      const discountType = clean(rule['F'] || rule['col_5'] || '');
      const value = parsePrice(rule['G'] ?? rule['col_6']);
      if (value === null || value < 0) {
        console.error('Regla de promoción con descuento inválido:', rule);
        return { finalPrice: Math.max(0, basePrice), promoCode: 'Sin Promo', discountApplied: 0 };
      }
      const discount = discountType === 'PORCENTAJE'
        ? basePrice * (value / 100)
        : value;
      return {
        finalPrice: Math.max(0, basePrice - discount),
        promoCode: String(rule['B'] || rule['col_1']).trim(),
        discountApplied: discount
      };
    };

    const fetchGoogleSheetJson = async (sheetId) => {
      if (!sheetId) return [];
      try {
        let cleanId = sheetId;
        let gid = '';
        if (cleanId.includes('gid=')) {
          const matchGid = cleanId.match(/gid=([0-9]+)/);
          if (matchGid) gid = matchGid[1];
          cleanId = cleanId.split('?')[0].split('&')[0];
        }
        let url = `https://docs.google.com/spreadsheets/d/${cleanId}/gviz/tq?tqx=out:json`;
        if (gid) url += `&gid=${gid}`;
        const response = await fetch(url);
        if (!response.ok) throw new Error(`HTTP error ${response.status}`);
        const text = await response.text();
        if (text.includes('<!DOCTYPE html') || text.includes('<html')) return [];
        const match = text.match(/google\.visualization\.Query\.setResponse\(([\s\S]*)\);?/);
        let jsonString = match ? match[1] : '';
        if (!jsonString) {
          const firstBrace = text.indexOf('{');
          const lastBrace = text.lastIndexOf('}');
          if (firstBrace !== -1 && lastBrace !== -1) jsonString = text.substring(firstBrace, lastBrace + 1);
        }
        if (!jsonString) return [];
        const json = JSON.parse(jsonString);
        if (!json || !json.table || !json.table.rows) return [];
        const cols = (json.table.cols || []).map(c => c ? c.label || c.id || '' : '');
        const getColLetter = (idx) => {
          let temp, letter = '', i = idx;
          while (i >= 0) { temp = i % 26; letter = String.fromCharCode(temp + 65) + letter; i = Math.floor(i / 26) - 1; }
          return letter;
        };
        return (json.table.rows || []).map(r => {
          const rowObj = {};
          if (r && r.c) {
            r.c.forEach((cell, idx) => {
              const val = cell ? (cell.v !== null && cell.v !== undefined ? cell.v : (cell.f || '')) : '';
              const colLetter = getColLetter(idx);
              const rawLabel = cols[idx] ? cols[idx].trim() : '';
              rowObj[colLetter] = val;
              rowObj[`col_${idx}`] = val;
              if (rawLabel) { rowObj[rawLabel] = val; rowObj[clean(rawLabel)] = val; }
            });
          }
          return rowObj;
        });
      } catch (err) {
        console.error(`Error al obtener datos de Google Sheets (${sheetId}):`, err);
        return [];
      }
    };

    // ============================================================
    // ICONOS Y COMPONENTES
    // ============================================================
    const Icon = ({ name, size = 17, className = '' }) => {
      const common = { width: size, height: size, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', strokeWidth: 2, strokeLinecap: 'round', strokeLinejoin: 'round', className, 'aria-hidden': true };
      const paths = {

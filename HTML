      };

      const INACTIVITY_LIMIT = 2 * 60 * 60 * 1000;
      useEffect(() => {
        if (!currentUser) return;
        let logoutTimer;
        const resetInactivityTimer = () => {
          if (logoutTimer) clearTimeout(logoutTimer);
          try { sessionStorage.setItem('zebra_last_activity', Date.now().toString()); } catch (e) {}
          logoutTimer = setTimeout(() => handleLogout('Tu sesión se cerró automáticamente tras 2 horas de inactividad.'), INACTIVITY_LIMIT);
        };
        try {
          const lastActive = sessionStorage.getItem('zebra_last_activity');
          if (lastActive) {
            const elapsed = Date.now() - parseInt(lastActive, 10);
            if (elapsed >= INACTIVITY_LIMIT) { handleLogout('Tu sesión anterior expiró por 2 horas de inactividad.'); return; }
          }
        } catch (e) {}
        resetInactivityTimer();
        const activityEvents = ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'];
        const onActivity = () => resetInactivityTimer();
        activityEvents.forEach(evt => window.addEventListener(evt, onActivity, { passive: true }));
        return () => {
          if (logoutTimer) clearTimeout(logoutTimer);
          activityEvents.forEach(evt => window.removeEventListener(evt, onActivity));
